{
  "name": "dual402",
  "version": "0.1.0",
  "description": "Express middleware that accepts both x402 and MPP payments on the same route",
  "type": "module",
  "main": "dist/express.js",
  "types": "dist/express.d.ts",
  "exports": {
    ".": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/dual402.smoke.mjs",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepare": "npm run build || true"
  },
  "dependencies": {
    "mppx": "0.6.14"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurrs/dual402.git"
  },
  "homepage": "https://github.com/mmurrs/dual402#readme",
  "bugs": {
    "url": "https://github.com/mmurrs/dual402/issues"
  },
  "keywords": [
    "x402",
    "mpp",
    "express",
    "payments",
    "tempo",
    "agentcash"
  ]
}
