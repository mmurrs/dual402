{
  "name": "dual402",
  "version": "0.1.5",
  "description": "One Express middleware for paid APIs: accept x402 and MPP payments, with OpenAPI and /.well-known/x402 discovery.",
  "type": "module",
  "main": "dist/express.js",
  "types": "dist/express.d.ts",
  "exports": {
    ".": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    }
  },
  "files": [
    "AGENTS.md",
    ".env.example",
    "dist",
    "examples/README.md",
    "examples/minimal-api.js",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/dual402.smoke.mjs",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "mppx": "0.6.27"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurrs/dual402.git"
  },
  "homepage": "https://github.com/mmurrs/dual402#readme",
  "bugs": {
    "url": "https://github.com/mmurrs/dual402/issues"
  },
  "keywords": [
    "x402",
    "mpp",
    "mppx",
    "pay-per-request",
    "api-monetization",
    "discovery",
    "openapi",
    "well-known",
    "micropayments",
    "express",
    "express-middleware",
    "402",
    "payments",
    "stablecoin",
    "usdc",
    "tempo",
    "base",
    "coinbase",
    "cdp",
    "agentic",
    "agents",
    "agentcash"
  ]
}
